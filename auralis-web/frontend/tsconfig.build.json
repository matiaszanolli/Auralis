{
  // Production-scoped type-check config (#4143).
  //
  // The base tsconfig.json includes every file under src/, so `tsc --noEmit`
  // also reports errors in test files. This config inherits all strict
  // settings but excludes test code so CI can gate on PRODUCTION type safety
  // (which must stay at zero errors). Since #5640 the test files are clean too
  // and the full `type-check` is a second blocking step in
  // frontend-typecheck.yml; this file's excludes still define that gate's
  // production scope.
  "extends": "./tsconfig.json",
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**",
    "src/tests/**"
  ]
}
