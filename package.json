{
  "name": "auralis",
  "version": "1.5.1",
  "packageManager": "pnpm@10.20.0",
  "description": "Auralis Audio Mastering Suite",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node dev.js",
    "test": "python -m pytest tests/",
    "test:coverage": "python -m pytest tests/ --cov=auralis --cov-report=html",
    "install:all": "pnpm run install:desktop && pnpm run install:frontend",
    "install:desktop": "cd desktop && pnpm install",
    "install:frontend": "cd auralis-web/frontend && pnpm install",
    "clean": "rm -rf dist/ desktop/node_modules/ auralis-web/frontend/node_modules/ auralis-web/frontend/dist/ auralis-web/backend/dist/ auralis-web/backend/build/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matiaszanolli/Auralis.git"
  },
  "keywords": [
    "audio",
    "mastering",
    "music",
    "electron",
    "python",
    "react"
  ],
  "author": "Auralis Team",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/matiaszanolli/Auralis/issues"
  },
  "homepage": "https://github.com/matiaszanolli/Auralis#readme",
  "engines": {
    "node": ">=24.0.0",
    "python": ">=3.14.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "shell-quote": "1.11.0"
  }
}
